{
  "name": "@ora-space/opencode-agent",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "check": "deno check src/main.ts tests/host-simulator.ts",
    "lint": "deno lint src vendor tests",
    "format": "deno fmt src vendor tests deno.json package.json README.md",
    "simulate": "deno run --allow-run --allow-read --allow-env --allow-net tests/host-simulator.ts",
    "dev": "deno run --no-prompt --allow-run --allow-read --allow-env --allow-net src/main.ts",
    "build": "deno bundle src/main.ts -o dist/main.js"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom", "esnext"]
  },
  "fmt": {
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
